{
  "name": "layout-canvas",
  "version": "0.0.0",
  "private": true,
  "description": "Корень монорепозитория Layout Canvas: npm workspaces и общие скрипты.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w frontend && npm run typecheck -w backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "npm run stylelint -w frontend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run stylelint && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
