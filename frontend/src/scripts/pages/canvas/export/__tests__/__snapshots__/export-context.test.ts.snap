exports[`exportSelectedHtml > демо: «charts» с замером 1`] = `
"<!-- Фрагмент корневого блока «Дашборд» (ширина превью 1440px)
  Путь: Дашборд › body › main › charts
  Родитель «main» (div): flex column, gap 24px, padding 24px
  Место: 2-й ребёнок из 3; ширина — растягивается на всю ширину родителя (~1128px, ~100% ширины родителя); высота — по содержимому
-->
<!-- charts -->
<div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:16px">
  <div style="min-height:200px"><!-- chart-left --></div>
  <div style="min-height:200px"><!-- chart-right --></div>
</div>
"
`;

