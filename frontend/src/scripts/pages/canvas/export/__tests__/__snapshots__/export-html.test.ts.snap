// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`exportRootHtml > демо-документ: корень «Дашборд» 1`] = `
"<!-- Корневой блок «Дашборд», ширина превью 1440px -->
<div style="display:flex; flex-direction:column">
  <!-- header -->
  <div style="display:flex; align-items:center; gap:16px; padding:12px 24px">
    <div style="width:120px"><!-- logo --></div>
    <!-- nav -->
    <div style="display:flex; gap:12px; flex:1">
      <div><!-- nav-item --></div>
      <div><!-- nav-item --></div>
      <div><!-- nav-item --></div>
    </div>
    <div style="width:160px"><!-- user --></div>
  </div>
  <!-- body -->
  <div style="display:grid; grid-template-columns:240px 1fr; gap:0px">
    <!-- sidebar -->
    <div style="display:flex; flex-direction:column; gap:8px; padding:16px">
      <div><!-- menu-item --></div>
      <div><!-- menu-item --></div>
      <div><!-- menu-item --></div>
    </div>
    <!-- main -->
    <div style="display:flex; flex-direction:column; gap:24px; padding:24px">
      <!-- kpi-row -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px">
        <div><!-- компонент «KPI-плашка» --></div>
        <div><!-- компонент «KPI-плашка» --></div>
        <div><!-- компонент «KPI-плашка» --></div>
        <div><!-- компонент «KPI-плашка» --></div>
      </div>
      <!-- charts -->
      <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:16px">
        <div style="min-height:200px"><!-- chart-left --></div>
        <div style="min-height:200px"><!-- chart-right --></div>
      </div>
      <div style="min-height:240px"><!-- table --></div>
    </div>
  </div>
</div>
"
`;
