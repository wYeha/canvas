exports[`exportRootHtml > демо-документ: корень «Дашборд» 1`] = `
"<!-- Компоненты (описание один раз, на местах — только имя):
  «KPI-карточка»
  «Карточка графика»
-->
<!-- Корневой блок «Дашборд», ширина превью 1440px, высота превью 900px, экран целиком (100vh), страница целиком не прокручивается — прокручиваются области внутри -->
<div style="display:flex; flex-direction:column; gap:var(--gap-m); height:100vh; --gap-m:16px">
  <!-- header -->
  <div style="display:flex; align-items:center; gap:var(--gap-m)">
    <div style="flex:none; width:120px"><!-- img: logo --></div>
    <!-- nav -->
    <div style="display:flex; gap:var(--gap-m); flex:1; min-width:0">
      <a><!-- nav-item --></a>
      <a><!-- nav-item --></a>
      <a><!-- nav-item --></a>
    </div>
    <!-- user -->
    <div style="display:flex; position:relative; flex:none; width:160px">
      <div style="position:absolute; top:0; right:0"><!-- status --></div>
    </div>
  </div>
  <!-- body -->
  <div style="display:grid; grid-template-columns:240px 1fr; gap:var(--gap-m); flex:1; min-height:0">
    <!-- sidebar -->
    <div style="display:flex; flex-direction:column; gap:var(--gap-m); align-self:stretch; min-height:0; overflow-y:auto">
      <h2 style="position:sticky; top:0"><!-- menu-title --></h2>
      <div data-repeat="16"><!-- menu-item ×16 --></div>
    </div>
    <!-- main -->
    <div style="display:flex; flex-direction:column; gap:var(--gap-m); justify-self:stretch; align-self:stretch">
      <!-- kpi-row -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:var(--gap-m)">
        <!-- компонент «KPI-карточка» ×4 -->
        <div data-repeat="4" style="display:flex; flex-direction:column; gap:var(--gap-m)">
          <div><!-- kpi-title --></div>
          <div><!-- kpi-value --></div>
        </div>
      </div>
      <!-- charts -->
      <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:var(--gap-m)">
        <!-- компонент «Карточка графика» -->
        <div style="display:flex; flex-direction:column; gap:var(--gap-m)">
          <div><!-- chart-title --></div>
          <div style="min-height:180px"><!-- chart-area --></div>
        </div>
        <!-- компонент «Карточка графика» -->
        <div style="display:flex; flex-direction:column; gap:var(--gap-m)">
          <div><!-- chart-title --></div>
          <div style="min-height:180px"><!-- chart-area --></div>
        </div>
      </div>
      <div style="min-height:240px"><!-- table --></div>
    </div>
  </div>
</div>
"
`;
