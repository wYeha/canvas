{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared": ["../shared/src/index.ts"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../shared/src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "../shared/src/**/__tests__/**"]
}
