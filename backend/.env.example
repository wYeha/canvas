# Пример переменных окружения бэкенда. Скопируйте в backend/.env и поправьте значения.

# Адрес и порт, на которых слушает API (снаружи доступ только через nginx)
HOST=127.0.0.1
PORT=3000

# Уровень логов Fastify: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Файл базы SQLite (относительно папки backend/ или абсолютный путь); папка создаётся при запуске
DATABASE_PATH=data/layout-canvas.db

# Хэш пароля входа (argon2). Сгенерировать: npm run hash-password -w backend
# Значение в одинарных кавычках, чтобы символы $ не трогались
PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$замените$на-свой-хэш'

# Флаг Secure у cookie сессии. Браузеры принимают Secure-cookie и на http://localhost;
# false — только если dev-сервер открывают по сети без HTTPS
COOKIE_SECURE=true

# true за nginx на этой же машине: IP клиента для лимита попыток входа — запись X-Forwarded-For, которую дописал nginx
# (доверяются только адреса loopback, подделанные клиентом записи не учитываются)
TRUST_PROXY=false
