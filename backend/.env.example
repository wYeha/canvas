# Пример переменных окружения бэкенда. Скопируйте в backend/.env и поправьте значения.

# Адрес и порт, на которых слушает API (снаружи доступ только через nginx)
HOST=127.0.0.1
PORT=3000

# Уровень логов Fastify: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Файл базы SQLite (относительно папки backend/ или абсолютный путь); папка создаётся при запуске
DATABASE_PATH=data/layout-canvas.db
